<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:desktop10="http://schemas.microsoft.com/appx/manifest/desktop/windows10/10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  IgnorableNamespaces="uap uap2 uap3 uap5 uap10 rescap desktop desktop4 desktop5 desktop10 com">

  <Identity
    Name="PaulBrinkmann.RuleOpen"
    ProcessorArchitecture="x64"
    Publisher="CN=1C346476-CE87-4371-A043-7D1DFD06F837"
    Version="1.0.1.0" />

  <Properties>
    <DisplayName>RuleOpen</DisplayName>
    <PublisherDisplayName>Paul Brinkmann</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application
      Id="RuleOpen.Desktop"
      Executable="RuleOpen.Desktop.exe"
      uap10:TrustLevel="mediumIL"
      uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        DisplayName="RuleOpen"
        Description="Context-aware file opening rules for Windows 11"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\LargeTile.png"
          Square71x71Logo="Assets\SmallTile.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="RuleOpen.Dispatcher.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="RuleOpen.Dispatcher.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>

        <uap:Extension Category="windows.fileTypeAssociation" Executable="RuleOpen.Dispatcher.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:FileTypeAssociation Name="ruleopen" Parameters="-- &quot;%1&quot;">
            <uap:DisplayName>RuleOpen Managed File</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.pdf</uap:FileType>
              <uap:FileType>.md</uap:FileType>
              <uap:FileType>.markdown</uap:FileType>
              <uap:FileType>.txt</uap:FileType>
              <uap:FileType>.rtf</uap:FileType>
              <uap:FileType>.doc</uap:FileType>
              <uap:FileType>.docx</uap:FileType>
              <uap:FileType>.odt</uap:FileType>
              <uap:FileType>.xls</uap:FileType>
              <uap:FileType>.xlsx</uap:FileType>
              <uap:FileType>.csv</uap:FileType>
              <uap:FileType>.ods</uap:FileType>
              <uap:FileType>.ppt</uap:FileType>
              <uap:FileType>.pptx</uap:FileType>
              <uap:FileType>.odp</uap:FileType>
              <uap:FileType>.json</uap:FileType>
              <uap:FileType>.xml</uap:FileType>
              <uap:FileType>.yaml</uap:FileType>
              <uap:FileType>.yml</uap:FileType>
              <uap:FileType>.toml</uap:FileType>
              <uap:FileType>.ini</uap:FileType>
              <uap:FileType>.cfg</uap:FileType>
              <uap:FileType>.conf</uap:FileType>
              <uap:FileType>.log</uap:FileType>
              <uap:FileType>.html</uap:FileType>
              <uap:FileType>.htm</uap:FileType>
              <uap:FileType>.css</uap:FileType>
              <uap:FileType>.js</uap:FileType>
              <uap:FileType>.ts</uap:FileType>
              <uap:FileType>.jsx</uap:FileType>
              <uap:FileType>.tsx</uap:FileType>
              <uap:FileType>.cs</uap:FileType>
              <uap:FileType>.py</uap:FileType>
              <uap:FileType>.cpp</uap:FileType>
              <uap:FileType>.c</uap:FileType>
              <uap:FileType>.h</uap:FileType>
              <uap:FileType>.hpp</uap:FileType>
              <uap:FileType>.rs</uap:FileType>
              <uap:FileType>.go</uap:FileType>
              <uap:FileType>.java</uap:FileType>
              <uap:FileType>.kt</uap:FileType>
              <uap:FileType>.ps1</uap:FileType>
              <uap:FileType>.sh</uap:FileType>
              <uap:FileType>.sql</uap:FileType>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
              <uap:FileType>.webp</uap:FileType>
              <uap:FileType>.gif</uap:FileType>
              <uap:FileType>.bmp</uap:FileType>
              <uap:FileType>.svg</uap:FileType>
              <uap:FileType>.tif</uap:FileType>
              <uap:FileType>.tiff</uap:FileType>
              <uap:FileType>.avif</uap:FileType>
              <uap:FileType>.ico</uap:FileType>
              <uap:FileType>.mp4</uap:FileType>
              <uap:FileType>.mkv</uap:FileType>
              <uap:FileType>.mov</uap:FileType>
              <uap:FileType>.avi</uap:FileType>
              <uap:FileType>.webm</uap:FileType>
              <uap:FileType>.mp3</uap:FileType>
              <uap:FileType>.wav</uap:FileType>
              <uap:FileType>.flac</uap:FileType>
              <uap:FileType>.ogg</uap:FileType>
              <uap:FileType>.m4a</uap:FileType>
              <uap:FileType>.aac</uap:FileType>
              <uap:FileType>.zip</uap:FileType>
              <uap:FileType>.7z</uap:FileType>
              <uap:FileType>.rar</uap:FileType>
              <uap:FileType>.tar</uap:FileType>
              <uap:FileType>.gz</uap:FileType>
              <uap:FileType>.epub</uap:FileType>
              <uap:FileType>.tex</uap:FileType>
              <uap:FileType>.rst</uap:FileType>
              <uap:FileType>.org</uap:FileType>
              <uap:FileType>.ics</uap:FileType>
              <uap:FileType>.eml</uap:FileType>
            </uap:SupportedFileTypes>
            <desktop10:IconHandler Clsid="7B42A9F1-4D8E-4E2A-B8E1-9E44C3B10110" />
          </uap3:FileTypeAssociation>
        </uap:Extension>

        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="RuleOpenMenu" Clsid="7B42A9F1-4D8E-4E2A-B8E1-9E44C3B10101" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="RuleOpenMenu" Clsid="7B42A9F1-4D8E-4E2A-B8E1-9E44C3B10101" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="RuleOpenMenu" Clsid="7B42A9F1-4D8E-4E2A-B8E1-9E44C3B10101" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>

        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="RuleOpen Explorer Shell Extensions">
              <com:Class
                Id="7B42A9F1-4D8E-4E2A-B8E1-9E44C3B10101"
                Path="RuleOpen.ShellExtension.dll"
                ThreadingModel="STA" />
              <com:Class
                Id="7B42A9F1-4D8E-4E2A-B8E1-9E44C3B10110"
                Path="RuleOpen.ShellExtension.dll"
                ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
