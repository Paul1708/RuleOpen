<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RuleOpen.Desktop.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Disabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" HorizontalAlignment="Stretch" Padding="32,20,32,28" Spacing="10">

            <TextBlock Text="About" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />

            <Border Style="{StaticResource RuleCardBorderStyle}" Padding="20">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image Source="ms-appx:///Assets/RuleOpenLogo.png" Width="64" Height="64" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="RuleOpen" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Text="Version 1.0.0  •  Windows 11 Native Utility"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="Rule-based file opening for Windows 11. Configure once, open naturally."
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <controls:SettingsCard
                Header="Source repository"
                Description="https://github.com/Paul1708/RuleOpen"
                IsClickEnabled="True"
                Click="GitHubCard_Click">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
            </controls:SettingsCard>

            <controls:SettingsCard Header="License" Description="Open-source under the MIT License">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8F1;" />
                </controls:SettingsCard.HeaderIcon>
                <TextBlock Text="MIT" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Header="Getting started tour"
                Description="Review how rules, context menus, and Windows Default Apps work"
                IsClickEnabled="True"
                Click="ShowTourCard_Click">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE897;" />
                </controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>

            <controls:SettingsExpander
                Header="How Windows integration works"
                Description="Privacy, safety, and Windows UserChoice compliance"
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE72E;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.ItemsFooter>
                    <StackPanel Padding="16,12" Spacing="8">
                        <TextBlock
                            Text="• Works 100% offline with zero telemetry, cloud sync, or background polling services."
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="• Respects Windows 11 UserChoice protection: RuleOpen never silently overwrites your existing file associations."
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="• Double-clicking launches the ultra-lightweight RuleOpen.Dispatcher executable without loading the WinUI management window."
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="• Automatically captures your prior default app before switching so unmatched files fall back cleanly."
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </controls:SettingsExpander.ItemsFooter>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
