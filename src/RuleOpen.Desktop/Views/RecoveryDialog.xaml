<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="RuleOpen.Desktop.Views.RecoveryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RuleOpen.Desktop.ViewModels"
    Title="{x:Bind ViewModel.Headline}"
    SecondaryButtonText="Create opening rule"
    CloseButtonText="Close">

    <StackPanel Spacing="12" MaxWidth="460" Padding="0,4">
        <TextBlock
            Text="{x:Bind ViewModel.Explanation}"
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="Wrap" />

        <TextBlock
            Text="{x:Bind ViewModel.FilePath}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

        <CheckBox x:Name="SaveRuleCheckBox" Content="Remember this choice as a rule for this folder" />

        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind ViewModel.SuggestedApps, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ApplicationChoiceViewModel">
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="10,8"
                            Margin="0,2"
                            Click="OpenWithAppButton_Click"
                            Tag="{x:Bind}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Grid.Column="0"
                                    Source="{x:Bind Icon}"
                                    Width="24"
                                    Height="24"
                                    Visibility="{x:Bind HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE737;"
                                    FontSize="18"
                                    Visibility="{x:Bind MissingIcon, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button
            Content="More apps (Windows Open With)..."
            Click="WindowsOpenWithButton_Click" />

        <InfoBar
            IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
            IsClosable="False"
            Severity="Error"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
