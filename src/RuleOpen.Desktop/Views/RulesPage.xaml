<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RuleOpen.Desktop.Views.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RuleOpen.Desktop.ViewModels"
    NavigationCacheMode="Disabled">

    <Grid MaxWidth="980" HorizontalAlignment="Stretch" Padding="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Opening rules" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Manage how files are opened based on their folder and extension."
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Warnings / Default Apps Notice -->
        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasConfigWarning, Mode=OneWay}"
                Severity="Warning"
                IsClosable="True"
                Title="Configuration recovered"
                Message="{x:Bind ViewModel.ConfigWarning, Mode=OneWay}" />

            <InfoBar
                IsOpen="{x:Bind ViewModel.ShowDefaultAppsPrompt, Mode=OneWay}"
                Severity="Informational"
                IsClosable="True"
                CloseButtonClick="DefaultAppsInfoBar_CloseButtonClick"
                Title="Windows default app setup"
                Message="{x:Bind ViewModel.DefaultAppsPromptText, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Open Default Apps" Click="OpenDefaultAppsButton_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- Search & Primary Action Row -->
        <Grid Grid.Row="2" ColumnSpacing="12" Margin="0,12,0,8" Visibility="{x:Bind ViewModel.HasRules, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                Grid.Column="0"
                PlaceholderText="Search rules, extensions, folders, or apps..."
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="Search opening rules" />

            <TextBlock
                Grid.Column="1"
                Text="{x:Bind ViewModel.FilterSummary, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Center" />

            <Button
                Grid.Column="3"
                Style="{StaticResource AccentButtonStyle}"
                Click="NewRuleButton_Click"
                AutomationProperties.Name="Create a new opening rule">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="New rule" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Empty State (no rules yet) -->
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            MaxWidth="420"
            Visibility="{x:Bind ViewModel.HasNoRules, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Image
                Source="ms-appx:///Assets/RuleOpenLogo.png"
                Width="56"
                Height="56"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="No opening rules yet"
                Style="{StaticResource SubtitleTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Create your first rule to choose which apps open files in different folders."
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Button
                    Content="Create a rule"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="NewRuleButton_Click" />
                <Button
                    Content="How it works"
                    Click="ShowOnboardingButton_Click" />
            </StackPanel>
        </StackPanel>

        <!-- Empty Search State -->
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10"
            Visibility="{x:Bind ViewModel.ShowNoSearchMatches, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <FontIcon Glyph="&#xE721;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock
                Text="No matching rules"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                HorizontalAlignment="Center" />
            <Button Content="Clear search" Click="ClearSearchButton_Click" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Rules List -->
        <ListView
            Grid.Row="4"
            ItemsSource="{x:Bind ViewModel.FilteredRules, Mode=OneWay}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="RulesListView_ItemClick"
            Visibility="{x:Bind ViewModel.HasRules, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,4" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:RuleItemViewModel">
                    <Border Style="{StaticResource RuleCardBorderStyle}">
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Edit" Click="EditMenuItem_Click" Tag="{x:Bind}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Duplicate" Click="DuplicateMenuItem_Click" Tag="{x:Bind}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Test with a file" Click="TestRuleMenuItem_Click" Tag="{x:Bind}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Delete" Click="DeleteMenuItem_Click" Tag="{x:Bind}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Border.ContextFlyout>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Real App Icon -->
                            <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center">
                                <Image
                                    Source="{x:Bind AppIcon, Mode=OneWay}"
                                    Width="32"
                                    Height="32"
                                    Visibility="{x:Bind HasAppIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <FontIcon
                                    Glyph="&#xE7C3;"
                                    FontSize="22"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="{x:Bind MissingAppIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>

                            <!-- Rule Metadata -->
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        Text="{x:Bind Name, Mode=OneWay}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        VerticalAlignment="Center" />

                                    <ItemsControl ItemsSource="{x:Bind Extensions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Style="{StaticResource ExtensionPillBorderStyle}">
                                                    <TextBlock Text="{x:Bind}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border
                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        Visibility="{x:Bind HasWarning, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock
                                            Text="{x:Bind WarningText}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </Border>
                                </StackPanel>

                                <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind FolderPath}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1"
                                        ToolTipService.ToolTip="{x:Bind FolderPath}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind SubfolderLabel}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        Text="{x:Bind ApplicationName}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind PriorityBadge}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Visibility="{x:Bind HasCustomPriority, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Toggle + More Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <ToggleSwitch
                                    IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                    OnContent=""
                                    OffContent=""
                                    MinWidth="0"
                                    AutomationProperties.Name="{x:Bind Name}" />

                                <Button
                                    ToolTipService.ToolTip="More actions"
                                    AutomationProperties.Name="Rule actions"
                                    Padding="8,6"
                                    Background="Transparent"
                                    BorderThickness="0">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuFlyoutItem Text="Edit" Click="EditMenuItem_Click" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Duplicate" Click="DuplicateMenuItem_Click" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Test with a file" Click="TestRuleMenuItem_Click" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Delete" Click="DeleteMenuItem_Click" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
