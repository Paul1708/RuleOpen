<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RuleOpen.Desktop.Views.RuleTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RuleOpen.Desktop.ViewModels"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    NavigationCacheMode="Disabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" HorizontalAlignment="Stretch" Padding="32,20,32,28" Spacing="16">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Test a file" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Check which rule and application would open a file without launching it. You can also drop a file here."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- File Input Bar -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    PlaceholderText="Enter or drop a file path (e.g., D:\University\lecture.pdf)..."
                    Text="{x:Bind ViewModel.SelectedFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    KeyDown="FilePathBox_KeyDown" />

                <Button Grid.Column="1" Content="Browse..." Click="BrowseFileButton_Click" />

                <Button
                    Grid.Column="2"
                    Content="Evaluate"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.CanEvaluate, Mode=OneWay}"
                    Click="EvaluateButton_Click" />
            </Grid>

            <!-- Result Card -->
            <Border
                Style="{StaticResource RuleCardBorderStyle}"
                Padding="20"
                Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="14">

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                            <Image
                                Source="{x:Bind ViewModel.SelectedAppIcon, Mode=OneWay}"
                                Width="36"
                                Height="36"
                                Visibility="{x:Bind ViewModel.HasSelectedAppIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <FontIcon
                                Glyph="&#xE7C3;"
                                FontSize="26"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind ViewModel.MissingSelectedAppIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                Content="Open with RuleOpen"
                                Click="TestOpenNowButton_Click"
                                Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <Button
                                Content="Create rule"
                                Click="CreateRuleFromTestButton_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Summary Key-Value Grid -->
                    <Grid ColumnSpacing="24" RowSpacing="10" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Selected file" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.NormalizedPathDisplay, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Matching rule" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.MatchingRuleName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Selected application" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.SelectedAppName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.SelectedAppKindLabel, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Default Handler Notice -->
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.ShowDefaultHandlerCallout, Mode=OneWay}"
                        IsClosable="False"
                        Severity="Informational"
                        Title="Explorer double-click note"
                        Message="{x:Bind ViewModel.DefaultHandlerNotice, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button Content="Open Default Apps" Click="OpenDefaultAppsButton_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <!-- Live Launch Result -->
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.HasLaunchFeedback, Mode=OneWay}"
                        IsClosable="True"
                        Severity="Success"
                        Message="{x:Bind ViewModel.LaunchFeedback, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Expandable Technical Details -->
            <Expander
                Header="Technical details"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="12" Padding="0,4">
                    <TextBlock
                        Text="{x:Bind ViewModel.ResolutionModeDisplay, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.CandidateRows, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RuleTestCandidateDisplay">
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="6"
                                    Padding="12,8"
                                    Margin="0,0,0,6">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind RuleName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="→" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind AppName}" Style="{StaticResource BodyTextBlockStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ScopeDisplay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind StatusSummary}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
