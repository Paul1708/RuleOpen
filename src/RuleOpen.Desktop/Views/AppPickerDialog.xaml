<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="RuleOpen.Desktop.Views.AppPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RuleOpen.Desktop.ViewModels"
    Title="{x:Bind ViewModel.DialogTitle, Mode=OneWay}"
    PrimaryButtonText="Select"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanConfirm, Mode=OneWay}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="12" MinWidth="460" Padding="0,4">
        <TextBlock
            Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
            Style="{StaticResource BodyTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

        <!-- Currently Selected Preview -->
        <Border Style="{StaticResource RuleCardBorderStyle}" Padding="12,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center">
                    <Image
                        Source="{x:Bind ViewModel.SelectedAppIcon, Mode=OneWay}"
                        Width="28"
                        Height="28"
                        Visibility="{x:Bind ViewModel.HasSelectedAppIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <FontIcon
                        Glyph="&#xE737;"
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.MissingSelectedAppIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.SelectedAppName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.SelectedAppDetail, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search + Browse .exe -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                PlaceholderText="Filter installed apps..."
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="1"
                Content="Browse .exe..."
                Click="BrowseExeButton_Click" />
        </Grid>

        <ProgressBar
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsDiscovering, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <StackPanel
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.HasRecommendedApps, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Text="Recommended apps"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.RecommendedApps, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ApplicationChoiceViewModel">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8,6"
                                    Click="SelectAppChoice_Click"
                                    Tag="{x:Bind}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Grid.Column="0"
                                            Source="{x:Bind Icon}"
                                            Width="24"
                                            Height="24"
                                            Visibility="{x:Bind HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                        <FontIcon
                                            Grid.Column="0"
                                            Glyph="&#xE737;"
                                            FontSize="18"
                                            Visibility="{x:Bind MissingIcon, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.HasOtherApps, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Text="Other registered apps"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.OtherApps, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ApplicationChoiceViewModel">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8,6"
                                    Click="SelectAppChoice_Click"
                                    Tag="{x:Bind}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Grid.Column="0"
                                            Source="{x:Bind Icon}"
                                            Width="24"
                                            Height="24"
                                            Visibility="{x:Bind HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                        <FontIcon
                                            Grid.Column="0"
                                            Glyph="&#xE737;"
                                            FontSize="18"
                                            Visibility="{x:Bind MissingIcon, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock
                    Text="No registered handlers found. Use 'Browse .exe...' to select a custom program."
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasNoDiscoveredApps, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</ContentDialog>
