<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="RuleOpen.Desktop.Views.OnboardingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Welcome to RuleOpen"
    PrimaryButtonText="Create your first rule"
    CloseButtonText="Skip for now"
    DefaultButton="Primary">

    <StackPanel Spacing="14" MaxWidth="460" Padding="0,4">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Image Source="ms-appx:///Assets/RuleOpenLogo.png" Width="40" Height="40" />
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Configure once. Open naturally." Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Text="Open files with different applications depending on their folder."
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <Border Style="{StaticResource RuleCardBorderStyle}" Padding="14">
            <StackPanel Spacing="10">
                <StackPanel Spacing="2">
                    <TextBlock Text="1. Create rules for folders and file types" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="For example, open PDFs in D:\University\ with Adobe Acrobat and PDFs in D:\Work\ with Microsoft Edge."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="2">
                    <TextBlock Text="2. Two ways to use RuleOpen in File Explorer" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="• Context menu: Right-click any file or folder → RuleOpen to create a rule or open immediately."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="• Double-click: Choose RuleOpen as the default app for an extension in Windows Settings to route files automatically."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="2">
                    <TextBlock Text="3. Windows respects your choice" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="RuleOpen never overwrites existing defaults silently. You can revert any extension back to its original app anytime in Windows Settings."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
