<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="RuleOpen.Desktop.Views.RuleEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RuleOpen.Desktop.ViewModels"
    Title="{x:Bind ViewModel.DialogTitle}"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText}"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="520" MinWidth="480" HorizontalAlignment="Stretch" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Padding="0,4">

            <!-- Rule Name -->
            <StackPanel Spacing="4">
                <TextBlock Text="Name" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBox
                    Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="e.g., University PDFs"
                    KeyDown="NameTextBox_KeyDown" />
            </StackPanel>

            <!-- File Type(s) -->
            <StackPanel Spacing="6">
                <TextBlock Text="File type" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBox
                    Text="{x:Bind ViewModel.ExtensionsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText=".pdf or .md, .markdown, .txt" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock
                        Text="Quick add:"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                    <Button Content=".pdf" Padding="8,3" Click="QuickExtButton_Click" Tag=".pdf" />
                    <Button Content=".md" Padding="8,3" Click="QuickExtButton_Click" Tag=".md" />
                    <Button Content=".txt" Padding="8,3" Click="QuickExtButton_Click" Tag=".txt" />
                    <Button Content=".png" Padding="8,3" Click="QuickExtButton_Click" Tag=".png" />
                    <Button Content=".docx" Padding="8,3" Click="QuickExtButton_Click" Tag=".docx" />
                </StackPanel>
            </StackPanel>

            <!-- Folder Scope -->
            <StackPanel Spacing="6">
                <TextBlock Text="Location" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        Text="{x:Bind ViewModel.FolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="D:\University\" />
                    <Button Grid.Column="1" Content="Browse..." Click="BrowseFolderButton_Click" />
                </Grid>
                <CheckBox
                    Content="Include subfolders"
                    IsChecked="{x:Bind ViewModel.IncludeSubfolders, Mode=TwoWay}" />
            </StackPanel>

            <!-- Application Picker -->
            <StackPanel Spacing="6">
                <TextBlock Text="Open with" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <Border Style="{StaticResource RuleCardBorderStyle}" Padding="12,10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center">
                            <Image
                                Source="{x:Bind ViewModel.SelectedAppIcon, Mode=OneWay}"
                                Width="28"
                                Height="28"
                                Visibility="{x:Bind ViewModel.HasSelectedAppIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <FontIcon
                                Glyph="&#xE737;"
                                FontSize="20"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind ViewModel.MissingSelectedAppIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind ViewModel.SelectedAppName, Mode=OneWay}"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.SelectedAppDetail, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <ToggleButton
                            Grid.Column="2"
                            Content="Choose"
                            IsChecked="{x:Bind ViewModel.IsPickerExpanded, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!-- Inline Expandable Application Picker -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Visibility="{x:Bind ViewModel.IsPickerExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                PlaceholderText="Filter installed apps..."
                                Text="{x:Bind ViewModel.AppSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Button
                                Grid.Column="1"
                                Content="Browse .exe..."
                                Click="BrowseExeButton_Click" />
                        </Grid>

                        <ProgressBar
                            IsIndeterminate="True"
                            Visibility="{x:Bind ViewModel.IsDiscoveringApps, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">
                                <!-- Recommended Apps -->
                                <StackPanel
                                    Spacing="4"
                                    Visibility="{x:Bind ViewModel.HasRecommendedApps, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        Text="Recommended apps"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.RecommendedApps, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ApplicationChoiceViewModel">
                                                <Button
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8,6"
                                                    Click="SelectAppChoice_Click"
                                                    Tag="{x:Bind}">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image
                                                            Grid.Column="0"
                                                            Source="{x:Bind Icon}"
                                                            Width="24"
                                                            Height="24"
                                                            Visibility="{x:Bind HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                                        <FontIcon
                                                            Grid.Column="0"
                                                            Glyph="&#xE737;"
                                                            FontSize="18"
                                                            Visibility="{x:Bind MissingIcon, Converter={StaticResource BoolToVisibility}}" />
                                                        <StackPanel Grid.Column="1" Spacing="1">
                                                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyTextBlockStyle}" />
                                                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Other Compatible Apps -->
                                <StackPanel
                                    Spacing="4"
                                    Visibility="{x:Bind ViewModel.HasOtherApps, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        Text="Other registered apps"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.OtherApps, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ApplicationChoiceViewModel">
                                                <Button
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8,6"
                                                    Click="SelectAppChoice_Click"
                                                    Tag="{x:Bind}">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image
                                                            Grid.Column="0"
                                                            Source="{x:Bind Icon}"
                                                            Width="24"
                                                            Height="24"
                                                            Visibility="{x:Bind HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                                        <FontIcon
                                                            Grid.Column="0"
                                                            Glyph="&#xE737;"
                                                            FontSize="18"
                                                            Visibility="{x:Bind MissingIcon, Converter={StaticResource BoolToVisibility}}" />
                                                        <StackPanel Grid.Column="1" Spacing="1">
                                                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyTextBlockStyle}" />
                                                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock
                                    Text="No registered handlers found for this extension. Use 'Browse .exe...' to select a custom program."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.HasNoDiscoveredApps, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Advanced Options -->
            <Expander Header="Advanced options" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="6" Padding="0,4">
                    <TextBlock Text="Priority (higher wins ties within the same folder depth)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <NumberBox
                        Value="{x:Bind ViewModel.Priority, Mode=TwoWay}"
                        Minimum="0"
                        Maximum="10000"
                        SmallChange="10"
                        SpinButtonPlacementMode="Inline"
                        Width="180"
                        HorizontalAlignment="Left" />
                </StackPanel>
            </Expander>

            <!-- Live Overlap Notice -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasOverlap, Mode=OneWay}"
                IsClosable="False"
                Severity="Informational"
                Title="Overlapping rule"
                Message="{x:Bind ViewModel.OverlapSummary, Mode=OneWay}" />

            <!-- Non-blocking Warning -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
                IsClosable="False"
                Severity="Warning"
                Message="{x:Bind ViewModel.WarningSummary, Mode=OneWay}" />

            <!-- Inline Validation Error -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasValidationError, Mode=OneWay}"
                IsClosable="False"
                Severity="Error"
                Message="{x:Bind ViewModel.ValidationError, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
