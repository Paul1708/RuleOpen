<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RuleOpen.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:RuleOpen.Desktop.ViewModels"
    NavigationCacheMode="Disabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" HorizontalAlignment="Stretch" Padding="32,20,32,28" Spacing="8">

            <StackPanel Spacing="4" Margin="0,0,0,12">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Configure appearance, Windows 11 integration, and rule behavior."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- General -->
            <TextBlock Text="General" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,4" />

            <controls:SettingsCard Header="App theme" Description="Choose how RuleOpen looks">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}" MinWidth="170">
                    <ComboBoxItem Content="Use system setting" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard Header="Language" Description="Display language">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xF2B7;" />
                </controls:SettingsCard.HeaderIcon>
                <TextBlock Text="English (United States)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </controls:SettingsCard>

            <!-- Windows integration -->
            <TextBlock Text="Windows integration" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />

            <controls:SettingsExpander
                Header="File Explorer context menu"
                Description="Add 'RuleOpen' actions to the Windows 11 right-click menu"
                IsExpanded="False">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xEC50;" />
                </controls:SettingsExpander.HeaderIcon>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        Header="Modern Windows 11 menu"
                        Description="{x:Bind ViewModel.ModernContextMenuDetail, Mode=OneWay}">
                        <Button
                            Content="{x:Bind ViewModel.ModernActionLabel, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanRegisterModernContextMenu, Mode=OneWay}"
                            Click="ToggleModernContextMenu_Click" />
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        Header="Classic per-user Explorer menu"
                        Description="Registers 'RuleOpen' under Show more options (HKCU, useful for unsigned local builds)"
                        Visibility="{x:Bind ViewModel.ShowClassicContextMenuOption, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ToggleSwitch
                            IsOn="{x:Bind ViewModel.ClassicContextMenuEnabled, Mode=TwoWay}"
                            OnContent="Enabled"
                            OffContent="Off" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasContextMenuFeedback, Mode=OneWay}"
                IsClosable="True"
                Severity="{x:Bind ViewModel.ContextMenuFeedbackSeverity, Mode=OneWay}"
                Message="{x:Bind ViewModel.ContextMenuFeedback, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        Content="Open Developer Settings"
                        Click="OpenDeveloperSettings_Click"
                        Visibility="{x:Bind ViewModel.ShowDeveloperSettingsButton, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <controls:SettingsExpander
                Header="Default file associations"
                Description="Register extensions so you can choose RuleOpen in Windows Default Apps"
                IsExpanded="False">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" />
                </controls:SettingsExpander.HeaderIcon>

                <Button
                    Content="Open Default Apps"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OpenDefaultApps_Click" />

                <controls:SettingsExpander.ItemsFooter>
                    <StackPanel Spacing="12" Padding="16,12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="280" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                PlaceholderText="Add extension (e.g. .pdf, .md)"
                                Text="{x:Bind ViewModel.NewExtensionInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Register" Click="RegisterExtension_Click" />
                            <Button Grid.Column="2" Content="Register common types" Click="RegisterCommonExtensions_Click" />
                        </Grid>

                        <InfoBar
                            IsOpen="{x:Bind ViewModel.HasAssociationFeedback, Mode=OneWay}"
                            IsClosable="True"
                            Severity="Informational"
                            Message="{x:Bind ViewModel.AssociationFeedback, Mode=OneWay}" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.RegisteredExtensions, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RegisteredExtensionItemViewModel">
                                    <Border
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6"
                                        Padding="12,8"
                                        Margin="0,0,0,6">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{x:Bind Extension}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind FriendlyName}" Style="{StaticResource BodyTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind DefaultStatusLabel}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock
                                                    Text="{x:Bind CapturedFallbackText}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Visibility="{x:Bind HasCapturedFallback, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>

                                            <Border
                                                Grid.Column="2"
                                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                CornerRadius="4"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind IsRuleOpenDefault, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock
                                                    Text="Active default"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            </Border>

                                            <Button
                                                Grid.Column="3"
                                                Content="Remove"
                                                Click="UnregisterExtension_Click"
                                                Tag="{x:Bind Extension}"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </controls:SettingsExpander.ItemsFooter>
            </controls:SettingsExpander>

            <controls:SettingsCard
                Header="File icons in Explorer"
                Description="How Windows displays file types when RuleOpen is their default app">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B9;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedExplorerIconModeIndex, Mode=TwoWay}" MinWidth="290">
                    <ComboBoxItem Content="Use matched routed app icon (Recommended)" />
                    <ComboBoxItem Content="RuleOpen extension icons" />
                    <ComboBoxItem Content="Inherit fallback app icon" />
                </ComboBox>
            </controls:SettingsCard>

            <!-- Behavior -->
            <TextBlock Text="Behavior" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />

            <controls:SettingsExpander
                Header="Fallback applications"
                Description="Used when no rule matches a dispatched file, and to resolve Explorer file icons"
                IsExpanded="False">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE74C;" />
                </controls:SettingsExpander.HeaderIcon>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image
                        Source="{x:Bind ViewModel.GlobalFallbackIcon, Mode=OneWay}"
                        Width="20"
                        Height="20"
                        Visibility="{x:Bind ViewModel.HasGlobalFallbackIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{x:Bind ViewModel.GlobalFallbackName, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="Choose..." Click="ChooseGlobalFallback_Click" />
                    <Button
                        Content="Clear"
                        Click="ClearGlobalFallback_Click"
                        Visibility="{x:Bind ViewModel.HasGlobalFallback, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <controls:SettingsExpander.ItemsFooter>
                    <StackPanel Spacing="10" Padding="16,12">
                        <TextBlock
                            Text="Per-extension fallback applications (auto-detected initially, customizable at any time):"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <InfoBar
                            IsOpen="{x:Bind ViewModel.HasFallbackFeedback, Mode=OneWay}"
                            IsClosable="True"
                            Severity="Informational"
                            Message="{x:Bind ViewModel.FallbackFeedback, Mode=OneWay}" />

                        <TextBlock
                            Text="No extensions tracked yet. Register an extension or create a rule to configure per-type fallbacks."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind ViewModel.HasExtensionFallbacks, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.ExtensionFallbacks, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExtensionFallbackItemViewModel">
                                    <Border
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6"
                                        Padding="12,8"
                                        Margin="0,0,0,6">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" MinWidth="96" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center">
                                                <Image
                                                    Source="{x:Bind Icon, Mode=OneWay}"
                                                    Width="24"
                                                    Height="24"
                                                    Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                <FontIcon
                                                    Glyph="&#xE7C3;"
                                                    FontSize="18"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Visibility="{x:Bind MissingIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>

                                            <Border
                                                Grid.Column="1"
                                                Style="{StaticResource ExtensionPillBorderStyle}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Extension}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            </Border>

                                            <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Button
                                                Grid.Column="3"
                                                Content="Change..."
                                                Click="ChangeExtensionFallback_Click"
                                                Tag="{x:Bind Extension}"
                                                VerticalAlignment="Center" />

                                            <Button
                                                Grid.Column="4"
                                                ToolTipService.ToolTip="More fallback options"
                                                AutomationProperties.Name="More fallback options"
                                                Padding="8,6"
                                                VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuFlyoutItem
                                                            Text="Auto-detect from Windows"
                                                            Click="AutoDetectExtensionFallback_Click"
                                                            Tag="{x:Bind Extension}">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem
                                                            Text="Clear"
                                                            Click="ClearExtensionFallback_Click"
                                                            Tag="{x:Bind Extension}"
                                                            IsEnabled="{x:Bind HasTarget}">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </controls:SettingsExpander.ItemsFooter>
            </controls:SettingsExpander>

            <controls:SettingsCard Header="Rule conflict handling" Description="How overlapping rules are resolved">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8CB;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedConflictModeIndex, Mode=TwoWay}" MinWidth="240">
                    <ComboBoxItem Content="Most specific folder first (Recommended)" />
                    <ComboBoxItem Content="Highest numeric priority first" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard Header="Diagnostic logging" Description="Write local rotating logs without file contents or telemetry">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D5;" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Open log folder" Click="OpenLogFolder_Click" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.DiagnosticLoggingEnabled, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                </StackPanel>
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
