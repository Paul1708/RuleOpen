<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="RuleOpen"
    Manufacturer="Paul Brinkmann"
    Version="$(var.ProductVersion)"
    Scope="perUser"
    UpgradeCode="8F5D4E21-6C7A-4920-9C24-73A08E772E01"
    Compressed="yes">

    <SummaryInformation Description="Context-aware file opening rules for Windows 11" />
    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      Schedule="afterInstallValidate"
      DowngradeErrorMessage="A newer version of RuleOpen is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="RuleOpenAppIcon" SourceFile="..\RuleOpen.Desktop\Assets\RuleOpen.ico" />
    <Property Id="ARPPRODUCTICON" Value="RuleOpenAppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Paul1708/RuleOpen" />
    <Property Id="DELETEUSERDATA" Value="ask" Secure="yes" />

    <!-- Installer UI with finish confirmation and "Launch RuleOpen" checkbox -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch RuleOpen" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <CustomAction
      Id="LaunchRuleOpen"
      Directory="INSTALLFOLDER"
      ExeCommand="&quot;[INSTALLFOLDER]RuleOpen.Desktop.exe&quot;"
      Execute="immediate"
      Impersonate="yes"
      Return="asyncNoWait" />

    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish
        Dialog="ExitDialog"
        Control="Finish"
        Event="DoAction"
        Value="LaunchRuleOpen"
        Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <!-- Register RuleOpen file associations in HKCU immediately after install/reinstall/upgrade -->
    <CustomAction
      Id="InstallRegister"
      Directory="INSTALLFOLDER"
      ExeCommand="&quot;[INSTALLFOLDER]RuleOpen.Dispatcher.exe&quot; --install-register"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore" />

    <!-- Clean up RuleOpen HKCU capabilities & Explorer menu on full uninstall (never touches unrelated apps) -->
    <CustomAction
      Id="UninstallCleanup"
      Directory="INSTALLFOLDER"
      ExeCommand="&quot;[INSTALLFOLDER]RuleOpen.Dispatcher.exe&quot; --uninstall-cleanup --ui-level &quot;[UILevel]&quot; --delete-user-data &quot;[DELETEUSERDATA]&quot;"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="InstallRegister" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="UninstallCleanup" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Feature Id="MainFeature" Title="RuleOpen" Level="1">
      <ComponentGroupRef Id="StagedApplicationFiles" />
      <ComponentGroupRef Id="ShortcutAndRegistryComponents" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="RuleOpen" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="RuleOpen" />
    </StandardDirectory>

    <ComponentGroup Id="ShortcutAndRegistryComponents">
      <Component Id="StartMenuShortcutComponent" Directory="AppMenuFolder" Guid="8F5D4E21-6C7A-4920-9C24-73A08E772E02">
        <Shortcut
          Id="RuleOpenStartMenuShortcut"
          Name="RuleOpen"
          Description="Configure context-aware file opening rules"
          Target="[INSTALLFOLDER]RuleOpen.Desktop.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="RuleOpenAppIcon" />
        <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\RuleOpen\Installer" Name="StartMenuInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="InstallFolderCleanupComponent" Directory="INSTALLFOLDER" Guid="8F5D4E21-6C7A-4920-9C24-73A08E772E03">
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveLocalProgramsFolder" Directory="LocalProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\RuleOpen\Installer" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
